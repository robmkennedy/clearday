{
  "name": "clearday",
  "version": "1.0.0",
  "description": "ClearDay — A simple, reliable todo application built with the BMAD method",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "stop": "kill-port 3000 5173 8080 8081; docker compose down 2>/dev/null; true",
    "test": "npm run test:shared && npm run test:backend && npm run test:frontend",
    "test:frontend": "npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:shared": "vitest --run",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "docker:dev": "docker compose --env-file .env.development up --build",
    "docker:test": "docker compose --env-file .env.test up --build",
    "docker:prod": "docker compose --env-file .env.production up --build -d",
    "docker:down": "docker compose down",
    "docker:down:v": "docker compose down -v",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^8.2.2",
    "jest-axe": "^10.0.0",
    "playwright": "^1.58.2",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
