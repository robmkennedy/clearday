# =============================================================================
# Clearday — Development Environment
# =============================================================================
# Usage:  docker compose --env-file .env.development up
#    or:  cp .env.development .env && docker compose up
#
# The override file (docker-compose.override.yml) is auto-loaded and sets:
#   - NODE_ENV=development, LOG_LEVEL=debug
#   - Backend port exposed on host (:3000)
#   - Relaxed read-only filesystem
#

# --- Compose behaviour ---
# Include the dev override (auto-loaded anyway, but explicit is clearer)
COMPOSE_PROFILES=dev

# --- General ---
# NOTE: NODE_ENV stays "production" inside Docker because the image is a
# production build (no devDependencies like pino-pretty).  Dev behaviour
# is driven by LOG_LEVEL, FRONTEND_URL, exposed ports, and relaxed security.
NODE_ENV=production
TAG=dev
TZ=UTC

# --- Backend ---
BACKEND_PORT=3000
BACKEND_HOST_PORT=3000
DATABASE_URL=./data/todos.db
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug
APP_VERSION=1.0.0-dev

# --- Frontend ---
FRONTEND_HOST_PORT=8080

# --- Resource limits (generous for dev) ---
BACKEND_CPU_LIMIT=2.0
BACKEND_MEM_LIMIT=1G
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEM_LIMIT=256M

# --- Dev tools ---
DB_ADMIN_PORT=8081

