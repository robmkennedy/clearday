# =============================================================================
# Clearday — Environment Configuration
# =============================================================================
#
# Per-environment files are provided — pick one:
#
#   cp .env.development .env    # local development (default)
#   cp .env.test .env           # test / CI
#   cp .env.production .env     # production deployment
#
# Or use --env-file without copying:
#
#   docker compose --env-file .env.development up
#   docker compose --env-file .env.test up
#   docker compose --env-file .env.production up
#
# npm shortcuts (defined in package.json):
#
#   npm run docker:dev          # development
#   npm run docker:test         # test
#   npm run docker:prod         # production
#

# ---------------------------------------------------------------------------
# Compose Behaviour
# ---------------------------------------------------------------------------

# Which compose files to load (colon-separated):
#   docker-compose.yml                                   → production base
#   docker-compose.yml:docker-compose.override.yml       → development (default)
#   docker-compose.yml:docker-compose.test.yml           → test / CI
# COMPOSE_FILE=docker-compose.yml

# Which profiles to activate (comma-separated):
#   dev   → db-admin SQLite browser
#   test  → test-backend isolated instance
# COMPOSE_PROFILES=dev

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Node environment (development, production, test)
NODE_ENV=development

# Image tag used for clearday-backend / clearday-frontend images
TAG=latest

# Timezone for all containers (affects log timestamps)
TZ=UTC

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Port the Express server listens on inside the container
BACKEND_PORT=3000

# SQLite database file path (relative to /app inside the container)
DATABASE_URL=./data/todos.db

# CORS allowed origin — must match the URL users access in the browser
# In production, set this to your real domain (e.g. https://clearday.example.com)
FRONTEND_URL=http://localhost:8080

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Resource limits (Docker deploy)
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M

# Host port to expose backend directly (dev/test only — not used in production)
# BACKEND_HOST_PORT=3000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# Host port mapped to the nginx container (the URL you open in the browser)
FRONTEND_HOST_PORT=8080

# Resource limits (Docker deploy)
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=128M

# ---------------------------------------------------------------------------
# Dev Tools (only active with: docker compose --profile dev up)
# ---------------------------------------------------------------------------

# Host port for the SQLite Web admin UI
DB_ADMIN_PORT=8081

# ---------------------------------------------------------------------------
# Test Profile (only active with: docker compose --profile test up)
# ---------------------------------------------------------------------------

# Host port for the isolated test-backend instance
TEST_BACKEND_PORT=3001

# Log level inside the test-backend container
TEST_LOG_LEVEL=silent

# See individual workspace .env.example files for workspace-specific variables:
# - backend/.env.example
# - frontend/.env.example

