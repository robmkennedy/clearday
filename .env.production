# =============================================================================
# Clearday — Production Environment
# =============================================================================
# Usage:  docker compose --env-file .env.production up
#
# Loads ONLY the base docker-compose.yml via COMPOSE_FILE (skips override):
#   - NODE_ENV=production
#   - Backend NOT exposed on host (internal only, behind nginx)
#   - Read-only filesystem, no-new-privileges
#   - JSON structured logging at info level
#

# --- Compose behaviour ---
# Base only — no override, no dev profile
COMPOSE_FILE=docker-compose.yml

# --- General ---
NODE_ENV=production
TAG=latest
TZ=UTC

# --- Backend ---
BACKEND_PORT=3000
DATABASE_URL=./data/todos.db
LOG_LEVEL=info
APP_VERSION=1.0.0

# ⚠️  REQUIRED — set this to your real domain before deploying
FRONTEND_URL=http://localhost:8080

# --- Frontend ---
FRONTEND_HOST_PORT=8080

# --- Resource limits ---
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=128M

