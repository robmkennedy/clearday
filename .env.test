# =============================================================================
# Clearday — Test Environment
# =============================================================================
# Usage:  docker compose --env-file .env.test up
#
# Loads the test overlay via COMPOSE_FILE (bypasses docker-compose.override.yml):
#   - NODE_ENV=test, LOG_LEVEL=warn
#   - Ephemeral tmpfs database (destroyed on container stop)
#   - Backend exposed on host :3001 for test runner access
#   - Frontend disabled by default
#   - Faster health check intervals (5s) for CI speed
#

# --- Compose behaviour ---
COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml

# --- General ---
NODE_ENV=test
TAG=test
TZ=UTC

# --- Backend ---
BACKEND_PORT=3000
BACKEND_HOST_PORT=3001
DATABASE_URL=/tmp/test-todos.db
FRONTEND_URL=http://localhost:8080
LOG_LEVEL=warn
TEST_LOG_LEVEL=silent
APP_VERSION=1.0.0-test

# --- Frontend (not started by default in test overlay) ---
FRONTEND_HOST_PORT=8080

# --- Test-profile backend ---
TEST_BACKEND_PORT=3001

# --- Resource limits (tight for CI) ---
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=128M

