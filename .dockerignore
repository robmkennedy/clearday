# =============================================================================
# .dockerignore — Keep Docker build context lean
# =============================================================================

# Version control
.git
.gitignore

# Dependencies (reinstalled in container)
node_modules
**/node_modules

# Build outputs (rebuilt in container)
**/dist
**/coverage
**/build

# Development data
data/
backend/data/

# IDE / Editor
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files (secrets should use Docker secrets or env vars)
.env
.env.*
!.env.example

# BMAD tooling (not needed at runtime)
_bmad/
_bmad-output/
docs/

# Test artifacts
e2e/
test-results/
playwright-report/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.ts
playwright.config.ts

# Docker files (prevent recursive context)
**/Dockerfile
docker-compose*.yml
.dockerignore

# Misc
*.md
!README.md
LICENSE

